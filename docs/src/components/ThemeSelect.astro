---
const { t } = Astro.locals;
const options = [
  { value: "auto", label: t("themeSelect.auto") },
  { value: "dark", label: t("themeSelect.dark") },
  { value: "light", label: t("themeSelect.light") },
];
---

<starlight-theme-select>
  <div role="group" aria-label={t("themeSelect.accessibleLabel")}>
    {
      options.map(({ value, label }) => (
        <button type="button" data-theme-value={value} aria-pressed="false">
          {label}
        </button>
      ))
    }
  </div>
</starlight-theme-select>

<script is:inline>
  document
    .querySelectorAll("starlight-theme-select button")
    .forEach((button) =>
      button.setAttribute(
        "aria-pressed",
        String(
          button.dataset.themeValue ===
            (localStorage.getItem("starlight-theme") || "auto"),
        ),
      ),
    );
</script>

<script>
  type Theme = "auto" | "dark" | "light";

  const storageKey = "starlight-theme";

  const parseTheme = (theme: unknown): Theme =>
    theme === "dark" || theme === "light" ? theme : "auto";

  const loadTheme = (): Theme =>
    parseTheme(
      typeof localStorage !== "undefined" && localStorage.getItem(storageKey),
    );

  const preferredScheme = (): Theme =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme =
      theme === "auto" ? preferredScheme() : theme;
    localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
    document
      .querySelectorAll<HTMLButtonElement>("starlight-theme-select button")
      .forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeValue === theme),
        ),
      );
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") applyTheme("auto");
  });

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      applyTheme(loadTheme());
      this.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
        button.addEventListener("click", () =>
          applyTheme(parseTheme(button.dataset.themeValue)),
        ),
      );
    }
  }
  customElements.define("starlight-theme-select", StarlightThemeSelect);
</script>

<style>
  [role="group"] {
    display: flex;
    border: 1px solid var(--sl-color-gray-5);
  }

  button {
    padding: 0.25rem 1ch;
    border: 0;
    background: none;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-sm);
    text-transform: lowercase;
    cursor: pointer;
  }

  button + button {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  button:hover {
    color: var(--sl-color-white);
  }

  button[aria-pressed="true"] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
</style>
